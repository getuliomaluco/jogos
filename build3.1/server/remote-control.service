[Unit]
Description=Remote Control WebSocket Server
After=network.target

[Service]
Type=simple
User=getulio
WorkingDirectory=/home/getulio/build3.1
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/getulio/.Xauthority
ExecStartPre=/bin/bash -lc 'until DISPLAY=:0 XAUTHORITY=/home/getulio/.Xauthority xdotool getmouselocation >/dev/null 2>&1; do sleep 1; done'
ExecStart=/usr/bin/python3 /home/getulio/build3.1/server.py --host 0.0.0.0 --port 8888 --interval-ms 200 --jpeg-quality 70
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
