[Unit]
Description=Remote Control WebSocket Server
After=network.target

[Service]
Type=simple
User=getulio
WorkingDirectory=/home/getulio/build3.1
EnvironmentFile=/home/getulio/build3.1/config.env
Environment=DISPLAY=${RC_DISPLAY}
Environment=XAUTHORITY=${RC_XAUTHORITY}
ExecStart=${RC_PYTHON} ${RC_SERVER_PATH}/server.py --host ${RC_HOST} --port ${RC_PORT} --interval-ms ${RC_INTERVAL_MS} --jpeg-quality ${RC_JPEG_QUALITY}
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
